# OpenRouter API Key (for AI dream interpretations)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your_api_key_here

# OpenRouter optional headers
OPENROUTER_REFERRER=https://your-app.example.com
OPENROUTER_APP_NAME=Dream Catcher

# Port the server runs on
PORT=3001

# Local PostgreSQL connection (PostgreSQL 17 via compose.yml)
DATABASE_URL=postgresql://user:password@localhost:5433/database
